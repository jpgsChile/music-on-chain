{
  "name": "music-on-chain-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run --exclude lib/domain/economics/execution/base/contract.test.ts --exclude lib/domain/economics/execution/base/integration.test.ts --exclude lib/domain/economics/execution/base/localEvm.matrix.test.ts --exclude lib/domain/economics/execution/base/sepolia.live.test.ts --exclude lib/domain/economics/execution/base/sepolia.fork.test.ts",
    "test:watch": "vitest",
    "test:e2e": "vitest run lib/domain/economics/execution/base/contract.test.ts lib/domain/economics/execution/base/integration.test.ts lib/domain/economics/execution/base/localEvm.matrix.test.ts",
    "test:fork": "vitest run lib/domain/economics/execution/base/sepolia.fork.test.ts",
    "test:contracts": "forge test",
    "test:sepolia": "vitest run lib/domain/economics/execution/base/sepolia.live.test.ts",
    "typecheck": "tsc --noEmit",
    "docs:validate": "node scripts/docs-validate.mjs"
  },
  "dependencies": {
    "@moc/adapters": "*",
    "@moc/application": "*",
    "@moc/domain": "*",
    "@moc/ports": "*",
    "@moc/shared": "*",
    "@prisma/adapter-better-sqlite3": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@privy-io/react-auth": "^3.13.1",
    "@privy-io/wagmi": "^4.0.1",
    "@tanstack/react-query": "^5.90.16",
    "@wagmi/connectors": "^7.0.6",
    "framer-motion": "^12.42.2",
    "next": "^16.1.6",
    "prisma": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.43.5",
    "wagmi": "^3.1.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "ganache": "^7.9.2",
    "postcss": "^8",
    "solc": "^0.8.24",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}

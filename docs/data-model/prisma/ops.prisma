// Platform / ops

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model OutboxMessage {
  id            String       @id
  type          String
  payloadJson   String       @map("payload_json")
  dedupeKey     String       @map("dedupe_key")
  correlationId String?      @map("correlation_id")
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at")
  publishedAt   DateTime?    @map("published_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@unique([type, dedupeKey])
  @@index([status, availableAt])
  @@map("outbox_messages")
  @@schema("ops")
}

model IdempotencyRecord {
  id           String   @id
  actorId      String   @map("actor_id")
  action       String
  key          String
  responseJson String?  @map("response_json")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@unique([actorId, action, key])
  @@index([expiresAt])
  @@map("idempotency_records")
  @@schema("ops")
}

model DomainEventAudit {
  id            String   @id
  type          String
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  payloadJson   String   @map("payload_json")
  correlationId String?  @map("correlation_id")
  occurredAt    DateTime @map("occurred_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([aggregateType, aggregateId, occurredAt])
  @@index([type, occurredAt])
  @@map("domain_event_audit")
  @@schema("ops")
}

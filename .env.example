# Database (Artist Profile – off-chain)
# SQLite for dev; use PostgreSQL URL in production
DATABASE_URL="file:./dev.db"

# Privy (wallet auth)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Artist wallets — Avalanche Fuji addresses that receive USDC (must be valid EIP-55 on Avalanche Fuji)
# For testing, use your own wallet address so you can receive test USDC.
NEXT_PUBLIC_CLEAVER_WALLET=0xYourAvalancheFujiAddress
NEXT_PUBLIC_SOU_WALLET=0xYourAvalancheFujiAddress

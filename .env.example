# Database (Artist Profile – off-chain)
# SQLite for dev; use PostgreSQL URL in production
DATABASE_URL="file:./prisma/dev.db"

# Privy (wallet auth) — REQUIRED for local/dev
# 1. Create an app at https://dashboard.privy.io
# 2. Copy the App ID (looks like: clxxxxxxxxxxxxxxxxxxxxxxxx)
# 3. Paste below (do NOT leave your_privy_app_id)
NEXT_PUBLIC_PRIVY_APP_ID=

# Base chain: omit or "sepolia" for Base Sepolia (development); "mainnet" for Base Mainnet
# NEXT_PUBLIC_BASE_CHAIN=sepolia

# On-chain settlement execution (optional). Domain stays mock unless ADAPTER=base.
# Do NOT put private keys here. The executor signer is injected by the host at runtime.
# MOC_SETTLEMENT_ADAPTER=mock
# MOC_SETTLEMENT_CHAIN_ID=84532
# MOC_SETTLEMENT_RPC_URL=
# MOC_SETTLEMENT_CONTRACT_ADDRESS=
# MOC_SETTLEMENT_USDC_ADDRESS=
# MOC_SETTLEMENT_EXECUTOR_ADDRESS=
# MOC_SETTLEMENT_CONTRACT_VERSION=MOC-SETTLEMENT-V1
# MOC_SETTLEMENT_ASSET=USDC
# MOC_SETTLEMENT_TOKEN_DECIMALS=6

# Artist wallets — Base EVM addresses that receive USDC payments
# For testing, use your own wallet address.
NEXT_PUBLIC_CLEAVER_WALLET=0xYourBaseAddress
NEXT_PUBLIC_SOU_WALLET=0xYourBaseAddress

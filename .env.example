# Database (Artist Profile – off-chain)
# SQLite for dev; use PostgreSQL URL in production
DATABASE_URL="file:./prisma/dev.db"

# Privy (wallet auth) — REQUIRED for local/dev
# 1. Create an app at https://dashboard.privy.io
# 2. Copy the App ID (looks like: clxxxxxxxxxxxxxxxxxxxxxxxx)
# 3. Paste below (do NOT leave your_privy_app_id)
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-side Privy verification (@privy-io/node). Names only — never commit secrets.
# PRIVY_APP_ID=                    # optional override of NEXT_PUBLIC_PRIVY_APP_ID
# PRIVY_APP_SECRET=                # required for POST /api/identity/session
# PRIVY_JWT_VERIFICATION_KEY=      # optional verification key for PrivyClient

# Base chain: omit or "sepolia" for Base Sepolia (development); "mainnet" for Base Mainnet
# NEXT_PUBLIC_BASE_CHAIN=sepolia

# Settlement test environments: local (default) | fork | base-sepolia
# EVM_ENV=local
# Never set EVM_ENV=mainnet — development commands refuse chainId 8453.
# MOC_SETTLEMENT_ADAPTER=mock
# Studio Liquidar uses mock unless this is explicitly `base`.
# `base` never falls back to mock. Requires chainId 84532, deployed MOCSettlement, MockUSDC, RPC, and BASE_EXECUTOR_PRIVATE_KEY.
# Never set MOC_SETTLEMENT_CHAIN_ID=8453 (MAINNET_FORBIDDEN).
# Unit tests force mock (`vitest.config.ts` / npm test) so they cannot send live transactions.
# MOC_SETTLEMENT_CHAIN_ID=84532
# BASE_SEPOLIA_RPC_URL=
# BASE_EXECUTOR_PRIVATE_KEY=
# MOC_SETTLEMENT_ADDRESS=
# MOC_SETTLEMENT_ASSET=
# Aliases (optional):
# MOC_SETTLEMENT_RPC_URL=
# MOC_SETTLEMENT_CONTRACT_ADDRESS=
# MOC_SETTLEMENT_USDC_ADDRESS=
# MOC_SETTLEMENT_EXECUTOR_ADDRESS=
# MOC_SETTLEMENT_CONTRACT_VERSION=MOC-SETTLEMENT-V1
# MOC_SETTLEMENT_ASSET_SYMBOL=USDC
# MOC_SETTLEMENT_TOKEN_DECIMALS=6

# Fan Economy trust execution. Off by default. Never falls back to the local harness.
# soroban requires Stellar testnet configuration and still refuses live RPC calls
# until a later deployment phase. Do not set STELLAR_NETWORK=public or mainnet.
# MOC_TRUST_EXECUTION=off
# STELLAR_NETWORK=testnet
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# MOC_FAN_ECONOMY_CONTRACT_ID=
# MOC_MATERIALIZER_PUBLIC_KEY=
# MOC_MATERIALIZER_SECRET is a signer secret. Never commit it.

# Artist wallets — Base EVM addresses that receive USDC payments
# For testing, use your own wallet address.
NEXT_PUBLIC_CLEAVER_WALLET=0xYourBaseAddress
NEXT_PUBLIC_SOU_WALLET=0xYourBaseAddress

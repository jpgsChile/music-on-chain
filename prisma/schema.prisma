// Persistence mapping for the current SQLite runtime.
// Domain specification lives in lib/domain — not in this file.
// SQLite may be replaced by PostgreSQL without changing Actor / Work / Participation semantics.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model ArtistProfile {
  id                    String   @id @default(cuid())
  actorRef              String?  @unique
  actor                 Actor?   @relation(fields: [actorRef], references: [actorRef])
  /// Capability / public lookup. Not Actor identity.
  wallet                String?  @unique
  artisticName          String
  country               String?
  username              String?
  biography             String?
  bannerUrl             String?
  avatarUrl             String?
  socials               Json?
  verified              Boolean  @default(false)
  creativeRoles         Json?
  defaultRoyaltySplits  Json?
  attestationHash       String?
  attestationChainId    Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// MOC Actor (ADR-011 ActorId). Opaque ActorRef; not a wallet and not a Privy subject.
model Actor {
  actorRef      String             @id
  createdAt     DateTime           @default(now())
  bindings      IdentityBinding[]
  wallets       ActorWallet[]
  artistProfile ArtistProfile?
  releases      MusicRelease[]
}

/// Wallet as a capability of an Actor. Not AuthSubject and not ActorRef.
model ActorWallet {
  id        String   @id @default(cuid())
  actorRef  String
  actor     Actor    @relation(fields: [actorRef], references: [actorRef])
  address   String   @unique
  createdAt DateTime @default(now())

  @@index([actorRef])
}

/// C-BIND/1 Binding persisted by MOC. AuthSubject = issuer + subject.
model IdentityBinding {
  id        String    @id @default(cuid())
  issuer    String
  subject   String
  actorRef  String
  actor     Actor     @relation(fields: [actorRef], references: [actorRef])
  status    String
  asOf      DateTime  @default(now())
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([issuer, subject])
  @@index([actorRef, status])
}

/// Musical work. Distinct from Release (publication) and Track (recording).
model MusicalWork {
  id        String         @id @default(cuid())
  actorRef  String
  title     String
  createdAt DateTime       @default(now())
  releases  MusicRelease[]

  @@index([actorRef])
}

/// Commercial publication that materializes a Work. Not the Work itself.
model MusicRelease {
  id             String          @id @default(cuid())
  workId         String
  work           MusicalWork     @relation(fields: [workId], references: [id])
  actorRef       String
  actor          Actor           @relation(fields: [actorRef], references: [actorRef])
  title          String
  releaseType    String
  language       String
  primaryGenre   String
  secondaryGenre String          @default("")
  description    String          @default("")
  coverUrl       String?
  status         String          @default("PUBLISHED")
  soloCreator    Boolean         @default(true)
  pricingModels  String          @default("[]")
  priceUsdc      Float           @default(0)
  network        String          @default("base")
  currency       String          @default("USDC")
  tokenId        String?
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  tracks         MusicTrack[]
  participations Participation[]

  @@index([actorRef])
  @@index([workId])
}

/// Recording that belongs to a Release (and therefore to a Work).
model MusicTrack {
  id          String       @id @default(cuid())
  releaseId   String
  release     MusicRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  title       String
  version     String       @default("")
  durationSec Int?
  explicit    Boolean      @default(false)
  lyrics      String       @default("")
  previewUrl  String?
  position    Int          @default(0)
}

/// Participation in a Release/Work. Identity is actorRef (or pending invite). Not a wallet.
model Participation {
  id                  String       @id @default(cuid())
  releaseId           String
  release             MusicRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  displayName         String
  email               String?
  actorRef            String?
  role                String
  revenueSharePercent Float
  createdAt           DateTime     @default(now())
  invite              ParticipationInvite?

  @@index([releaseId])
  @@index([actorRef])
}

/// Opaque invite for a pending Participation. Token stored hashed. Not Actor identity.
model ParticipationInvite {
  id                 String        @id @default(cuid())
  participationId    String        @unique
  participation      Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  tokenHash          String        @unique
  createdByActorRef  String
  acceptedAt         DateTime?
  createdAt          DateTime      @default(now())

  @@index([tokenHash])
}

/// Persistence mapping for economics. Domain specification: lib/domain/economics
model EconomicRevenue {
  id                  String                 @id
  originKind          String
  originId            String
  saleId              String?
  workId              String?
  releaseId           String?
  grossUnits          String
  protocolFeeUnits    String
  convenienceFeeUnits String
  netUnits            String
  scale               Int
  asset               String
  policyId            String
  policyVersion       Int
  protocolFeeBps      Int      @default(0)
  convenienceFeeBps   Int      @default(0)
  ruleId              String
  status              String                 @default("recorded")
  occurredAt          DateTime
  createdAt           DateTime               @default(now())
  entitlements        EconomicEntitlement[]

  @@unique([originKind, originId])
}

model EconomicEntitlement {
  id             String              @id
  revenueId      String
  revenue        EconomicRevenue     @relation(fields: [revenueId], references: [id])
  distributionId String
  actorRef       String
  units          String
  scale          Int
  asset          String
  shareBps       Int
  sourceKind     String
  sourceId       String?
  status         String
  createdAt      DateTime
  settledAt      DateTime?
  settlement     EconomicSettlement?

  @@index([actorRef])
  @@index([revenueId])
}

model EconomicSettlement {
  id                 String               @id
  entitlementId      String               @unique
  entitlement        EconomicEntitlement  @relation(fields: [entitlementId], references: [id])
  actorRef           String
  units              String
  scale              Int
  asset              String
  executionLayer     String
  destinationWallet  String?
  status             String
  createdAt          DateTime
  payment            EconomicPayment?
}

model EconomicPayment {
  id           String             @id
  settlementId String             @unique
  settlement   EconomicSettlement @relation(fields: [settlementId], references: [id])
  units        String
  scale        Int
  asset        String
  status       String
  createdAt    DateTime
}

/// Domain right. Not a token and not a revenue share.
model DomainRight {
  id         String   @id
  actorRef   String
  objectKind String
  objectId   String
  kind       String
  createdAt  DateTime @default(now())

  @@index([actorRef])
  @@index([objectKind, objectId])
}

/// Persistence mapping for the execution boundary. Domain: lib/domain/economics/execution
model SettlementIntent {
  id            String   @id
  entitlementId String   @unique
  actorRef      String
  units         String
  scale         Int
  asset         String
  createdAt     DateTime

  @@index([actorRef])
}

/// Opaque verified Actor session. Not Privy ID, not Actor identity, not a wallet.
model ActorSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  actorRef  String
  issuer    String
  subject   String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([actorRef])
  @@index([issuer, subject])
}

model ExecutionRequestRecord {
  id                     String   @id
  intentRef              String
  actorRef               String
  destinationCapability  String?
  units                  String
  scale                  Int
  asset                  String
  executionMode          String
  createdAt              DateTime

  @@index([intentRef])
}

model SettlementReceiptRecord {
  id            String   @id
  intentRef     String
  requestRef    String
  executionMode String
  status        String
  /// External evidence only. Not domain identity.
  externalRef   String?
  occurredAt    DateTime
  metadata      String?

  @@unique([intentRef, requestRef])
  @@index([intentRef])
}

/// Fan Economy. Domain: lib/domain/fanEconomy. Not a wallet ledger.
model Campaign {
  id              String    @id
  artistActorRef  String
  title           String
  asset           String
  scale           Int
  committedUnits  String
  reserveKind     String
  version         Int       @default(0)
  createdAt       DateTime  @default(now())
  missions        Mission[]

  @@index([artistActorRef])
}

model Mission {
  id                 String              @id
  campaignId         String
  campaign           Campaign            @relation(fields: [campaignId], references: [id])
  title              String
  criterion          String
  maximumRewardUnits String
  asset              String
  scale              Int
  assignmentMode     String
  status             String
  createdAt          DateTime            @default(now())
  assignments        MissionAssignment[]

  @@index([campaignId])
}

model MissionAssignment {
  id           String               @id
  missionId    String
  mission      Mission              @relation(fields: [missionId], references: [id])
  fanActorRef  String
  state        String
  createdAt    DateTime             @default(now())
  evidence     EvidenceRecord[]
  verifications VerificationRecord[]
  reward       RewardEntitlement?

  @@unique([fanActorRef, missionId])
  @@index([missionId])
}

model EvidenceRecord {
  id                String            @id
  assignmentId      String
  assignment        MissionAssignment @relation(fields: [assignmentId], references: [id])
  submitterActorRef String
  contentHash       String
  locator           String
  createdAt         DateTime          @default(now())

  @@index([assignmentId])
}

model VerificationRecord {
  id               String            @id
  assignmentId     String
  assignment       MissionAssignment @relation(fields: [assignmentId], references: [id])
  evidenceId       String
  outcome          String
  verifierActorRef String
  policyId         String
  current          Boolean           @default(false)
  createdAt        DateTime          @default(now())

  @@index([assignmentId, current])
}

model RewardEntitlement {
  id              String            @id
  assignmentId    String            @unique
  assignment      MissionAssignment @relation(fields: [assignmentId], references: [id])
  campaignId      String
  fanActorRef     String
  verificationId  String
  authorizedUnits String
  consumedUnits   String
  releasedUnits   String
  asset           String
  scale           Int
  version         Int               @default(0)
  createdAt       DateTime          @default(now())
  redemptions     Redemption[]
  releases        RewardReleaseCommand[]

  @@index([campaignId])
  @@index([fanActorRef])
}

model Redemption {
  id                  String            @id
  rewardEntitlementId String
  reward              RewardEntitlement @relation(fields: [rewardEntitlementId], references: [id])
  fanActorRef         String
  releaseId           String
  units               String
  asset               String
  scale               Int
  payloadHash         String
  revenueId           String            @unique
  state               String
  createdAt           DateTime          @default(now())
  reversedAt          DateTime?

  @@index([fanActorRef])
  @@index([rewardEntitlementId])
}

model RewardReleaseCommand {
  id                  String            @id
  rewardEntitlementId String
  reward              RewardEntitlement @relation(fields: [rewardEntitlementId], references: [id])
  fanActorRef         String
  units               String
  asset               String
  scale               Int
  payloadHash         String
  createdAt           DateTime          @default(now())
}

model FanEconomyTransition {
  id         String   @id @default(cuid())
  command    String
  actorRef   String
  authority  String
  subjectId  String
  priorState String
  nextState  String
  createdAt  DateTime @default(now())

  @@index([subjectId])
}
